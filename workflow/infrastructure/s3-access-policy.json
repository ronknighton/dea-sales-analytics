{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::dea-sales-analytics-project/raw/*"
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::dea-sales-analytics-project",
            "Condition": {
                "StringLike": {
                    "s3:prefix": [
                        "raw/*"
                    ]
                }
            }
        }
    ]
}